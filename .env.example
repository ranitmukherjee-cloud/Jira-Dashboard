PORT=3000

# Fireflies -> Jira sync (see README "Fireflies meeting sync" section)
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
# Optional but recommended on Vercel: locks down api/cron/fireflies-retry so
# only Vercel's own cron scheduler can trigger it. Any random string works —
# Vercel sends it back automatically as a bearer token when it invokes the job.
CRON_SECRET=
